    "keyVaultName": "[format('kv-epcrag-{0}', parameters('uniqueSuffix'))]",
    "appInsightsName": "[format('appi-epcrag-{0}', parameters('environmentName'))]",
    "logAnalyticsName": "[format('log-epcrag-{0}', parameters('environmentName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {

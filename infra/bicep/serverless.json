      "metadata": {
        "description": "Container image for Node.js Gateway Microservice (default: quickstart starter image until built)"
      }
    }
  },
  "variables": {
    "containerAppEnvName": "[format('cae-epcrag-{0}-{1}', parameters('environmentName'), parameters('uniqueSuffix'))]",
    "nodeGatewayAppName": "[format('app-node-gateway-{0}-{1}', parameters('environmentName'), parameters('uniqueSuffix'))]",

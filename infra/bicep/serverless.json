      "type": "string",
      "defaultValue": "[substring(uniqueString(resourceGroup().id), 0, 6)]",
      "metadata": {
        "description": "Unique suffix for globally unique resource names"
      }
    },
    "jvmImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/k8se/quickstart:latest",
      "metadata": {
        "description": "Container image for JVM Graph Microservice (default: quickstart starter image until built)"
      }

  "outputs": {
    "nodeGatewayUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('nodeGatewayAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "jvmGraphInternalUrl": {
      "type": "string",
      "value": "[format('http://{0}', variables('jvmGraphAppName'))]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri]"

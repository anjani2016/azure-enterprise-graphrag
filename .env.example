# Server Config
PORT=3000
NODE_ENV=development
JVM_GRAPH_SERVICE_URL=http://localhost:8081

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Storage (Blob)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_RAW=raw-documents
AZURE_STORAGE_CONTAINER_RENDERED=rendered-reports

# Azure Key Vault
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# Microsoft Entra ID (Azure AD) - OAuth 2.0 / OIDC
AZURE_ENTRA_TENANT_ID=your-tenant-id
AZURE_ENTRA_CLIENT_ID=your-client-id
AZURE_ENTRA_AUDIENCE=api://azure-enterprise-graphrag

# Third-Party Integrations
SERVICENOW_INSTANCE=https://dev12345.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=your-snow-password

JIRA_HOST=https://your-company.atlassian.net
JIRA_EMAIL=engineer@company.com
JIRA_API_TOKEN=your-jira-api-token

MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-app-id
MS_GRAPH_CLIENT_SECRET=your-client-secret
